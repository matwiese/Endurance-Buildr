# Buildr Force – Server (apps/server). Alle Werte optional; ohne DATABASE_URL läuft eine eingebettete PGlite-Datenbank.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL (Produktion). Leer lassen für lokales PGlite unter DATA_DIR/pg.
# DATABASE_URL=postgres://buildr:secret@localhost:5432/buildr
# Relative Pfade (DATA_DIR, BLOB_DIR, WEB_DIST) gelten ab dem Verzeichnis, in dem der pnpm-Befehl eingegeben wurde (INIT_CWD).
DATA_DIR=.data
# Roh-Aufnahmen (BFB1); Standard DATA_DIR/blobs
# BLOB_DIR=.data/blobs
MAX_BLOB_MB=64

# Sitzungen / Cookies
SESSION_TTL_DAYS=14
# Standard: nur in Produktion true (HTTPS erforderlich)
# COOKIE_SECURE=true
# Zusätzliche Ursprünge, die Cookie-Anfragen stellen dürfen (Komma-getrennt). Eigener Host ist immer erlaubt.
# ALLOWED_ORIGINS=https://force.example.org
# Hinter Reverse-Proxy: Client-IP aus X-Forwarded-For (Login-Drosselung)
# TRUST_PROXY=true
SCRYPT_LOG_N=15
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MIN=15

# Erstinstallation ohne Wizard (nur wirksam, solange es noch keinen Nutzer gibt)
# BOOTSTRAP_ORG="Mein Verein"
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_PASSWORD=mindestens-10-zeichen

# Gebaute Web-App (apps/web/dist) vom Server ausliefern (Ein-Prozess-Betrieb)
# WEB_DIST=apps/web/dist
