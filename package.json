{
  "name": "buildr-force",
  "private": true,
  "version": "0.1.0",
  "description": "Buildr Force – Kraftmessplatten-Testsystem für Sprungdiagnostik (Monorepo)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @buildr/server --filter @buildr/web dev",
    "dev:server": "pnpm --filter @buildr/server dev",
    "dev:web": "pnpm --filter @buildr/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @buildr/e2e test",
    "docs:metrics": "pnpm --filter @buildr/core docs:metrics",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e:prod": "pnpm --filter @buildr/e2e test:prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
